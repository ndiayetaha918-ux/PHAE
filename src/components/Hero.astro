---
/* L'arrivée. Le bâtiment, sa caractéristique de feu, et une phrase
   qui dit ce qu'on vient y faire. Rien d'autre.

   L'image est le rendu du modèle, servi en statique: la page ouvre
   vite, et la 3D vivante n'est chargée qu'à la section d'ascension. */
---

<section class="lieu haut" id="haut">
  <div class="wrap haut__grille">
    <div class="haut__dire">
      <h1 class="monument haut__titre">
        <span class="reveal" style="--reveal-delay:60ms">On monte</span>
        <span class="monument--contre reveal" style="--reveal-delay:170ms">jusqu’à la lampe.</span>
      </h1>

      <p class="dit haut__fait reveal" style="--reveal-delay:290ms">
        Allumé en 1864 à cent vingt-six mètres au dessus de l’Atlantique.
        Premier musée national des Phares et Balises.
      </p>

      <a class="btn haut__cta reveal" style="--reveal-delay:370ms" href="#ascension">
        Commencer l’ascension
      </a>
    </div>

    <figure class="haut__phare">
      <picture>
        <source srcset="/media/phare-poster.webp" type="image/webp" />
        <img
          src="/media/phare-poster.png"
          alt="Le Phare des Mamelles: tour cylindrique fuselée sur un corps de logis de deux étages, galerie à garde-corps, lanterne vitrée et dôme à patine."
          width="1100"
          height="1380"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
      <figcaption class="tech haut__carac">
        <span class="haut__trait"></span>Fl W 5s
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .haut {
    min-height: calc(100svh - var(--nav-h));
    display: grid;
    align-items: end;
    border-bottom: 1px solid var(--filet-franc);
  }

  .haut__grille {
    width: 100%;
    display: grid;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: end;
    padding-bottom: clamp(1.75rem, 5vh, 5rem);
    padding-top: clamp(4.75rem, 10vh, 8rem);
  }

  .haut__titre span { display: block; }
  .haut__titre .monument--contre { text-transform: none; }

  .haut__fait { margin-top: clamp(1rem, 2.4vh, 2.25rem); color: var(--texte-doux); }
  .haut__cta { margin-top: clamp(1.25rem, 3vh, 2.5rem); }

  .haut__phare { position: relative; margin: 0; }
  .haut__phare img { width: 100%; height: auto; }

  /* Sur petit écran le repère passe à gauche de la lanterne: à droite
     il viendrait buter sur le bord. */
  .haut__carac {
    position: absolute;
    right: 62%;
    top: 15%;
    display: flex;
    flex-direction: row-reverse;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    color: var(--texte);
    white-space: nowrap;
  }
  .haut__trait {
    display: block;
    width: clamp(0.9rem, 3vw, 2.4rem);
    height: 1px;
    background: var(--basalte);
  }

  @media (min-width: 62rem) {
    .haut__grille {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.72fr);
      gap: clamp(2rem, 5vw, 5rem);
      align-items: center;
      padding-top: clamp(5rem, 11vh, 7rem);
    }
    .haut__dire { padding-bottom: clamp(0rem, 3vh, 2rem); }
    .haut__phare img { max-height: 74svh; width: auto; margin-left: auto; }
    .haut__carac {
      font-size: 0.75rem;
      right: auto;
      left: 62%;
      flex-direction: row;
    }
  }

  @media (max-width: 61.99rem) {
    .haut__grille { align-content: space-between; gap: 1rem; }
    .haut__phare { width: 54%; max-width: 15rem; margin-left: auto; margin-top: -0.5rem; }
    .haut__dire { order: 2; }
  }
</style>
