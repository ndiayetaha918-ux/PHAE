---
import { identity, nav } from '../data/site';
---

<header class="nav" id="nav">
  <div class="nav__inner">
    <a class="mark" href="#haut" aria-label={`${identity.name}, retour en haut`}>
      <span class="mark__nom">Phare des Mamelles</span>
      <span class="mark__role">{identity.role}</span>
    </a>

    <nav class="nav__liens" aria-label="Sections">
      {nav.filter((i) => i.href !== '#venir').map((i) => <a href={i.href}>{i.label}</a>)}
    </nav>

    <div class="nav__actions">
      <a class="btn nav__cta" href="#venir">Venir</a>
      <button class="burger" type="button" aria-expanded="false" aria-controls="menu" aria-label="Ouvrir le menu">
        <span aria-hidden="true"></span><span aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<div class="menu" id="menu" hidden>
  <nav class="menu__liste" aria-label="Menu principal">
    {nav.map((i, n) => <a href={i.href} style={`--i:${n}`}>{i.label}</a>)}
  </nav>
</div>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    color: var(--texte);
    transition: color 700ms var(--ease-in-out), background-color 700ms var(--ease-in-out);
  }
  .nav[data-pose] {
    background: color-mix(in oklab, var(--fond) 88%, transparent);
    backdrop-filter: saturate(1.3) blur(12px);
    -webkit-backdrop-filter: saturate(1.3) blur(12px);
    border-bottom: 1px solid var(--filet);
  }
  @supports not (backdrop-filter: blur(1px)) { .nav[data-pose] { background: var(--fond); } }

  /* Dans la lanterne, la barre s'inverse avec la page. */
  .nav[data-nuit] {
    --fond: var(--basalte);
    --texte: #f2f3f0;
    --texte-tenu: #8a938f;
    --filet: #ffffff26;
    --filet-franc: #ffffff;
    --btn-fond: #ffffff;
    --btn-texte: var(--basalte);
    color: #f2f3f0;
  }

  .nav__inner {
    max-width: var(--page);
    margin-inline: auto;
    padding: 0 var(--gutter);
    height: var(--nav-h);
    display: flex;
    align-items: center;
    gap: clamp(1rem, 4vw, 3rem);
  }

  .mark {
    text-decoration: none;
    display: grid;
    align-content: center;
    gap: 0.3em;
    margin-right: auto;
    min-height: 44px;
  }
  .mark__nom {
    font-variation-settings: 'wdth' 116;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.8125rem;
    line-height: 1;
  }
  .mark__role {
    font-family: 'Azeret Mono', monospace;
    font-size: 0.5625rem;
    letter-spacing: 0.11em;
    line-height: 1;
    color: var(--texte-tenu);
    text-transform: uppercase;
  }
  @media (max-width: 26rem) { .mark__role { display: none; } }

  .nav__liens { display: none; gap: clamp(1rem, 2.2vw, 2rem); white-space: nowrap; }
  .nav__liens a {
    text-decoration: none;
    font-family: 'Azeret Mono', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: var(--texte-tenu);
    transition: color var(--t-ui) var(--ease-out);
    padding-block: 0.5em;
  }
  @media (hover: hover) and (pointer: fine) { .nav__liens a:hover { color: var(--texte); } }
  .nav__liens a[aria-current='true'] { color: var(--accent); }

  .nav__actions { display: flex; align-items: center; gap: 0.75rem; }
  .nav__cta { display: none; padding: 0.75em 1.15em; font-size: 0.75rem; }

  .burger {
    appearance: none; background: none;
    border: 1px solid var(--filet-franc);
    color: inherit; width: 42px; height: 38px;
    display: grid; place-content: center; gap: 5px; cursor: pointer; padding: 0;
  }
  .burger span {
    display: block; width: 17px; height: 1px; background: currentColor;
    transition: transform var(--t-ui) var(--ease-out);
  }
  .burger[aria-expanded='true'] span:first-child { transform: translateY(3px) rotate(45deg); }
  .burger[aria-expanded='true'] span:last-child { transform: translateY(-3px) rotate(-45deg); }

  @media (min-width: 62rem) {
    .nav__liens { display: flex; }
    .nav__cta { display: inline-flex; }
    .burger { display: none; }
  }

  .menu {
    position: fixed; inset: 0; z-index: 45;
    background: var(--harmattan);
    padding: 88px var(--gutter) var(--gutter);
    display: grid; align-content: start;
    opacity: 0; transform: translate3d(0, -8px, 0);
    transition: opacity 220ms var(--ease-out), transform 220ms var(--ease-out);
  }
  .menu[data-ouvert] { opacity: 1; transform: none; }
  .menu__liste { display: grid; }
  .menu__liste a {
    text-decoration: none;
    font-variation-settings: 'wdth' 112;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    font-size: clamp(1.6rem, 8.5vw, 2.4rem);
    line-height: 1.2;
    padding-block: 0.35em;
    border-bottom: 1px solid var(--filet);
    opacity: 0; transform: translate3d(0, 12px, 0);
    transition:
      opacity 300ms var(--ease-out) calc(var(--i) * 45ms + 60ms),
      transform 300ms var(--ease-out) calc(var(--i) * 45ms + 60ms);
  }
  .menu[data-ouvert] .menu__liste a { opacity: 1; transform: none; }

  @media (prefers-reduced-motion: reduce) {
    .nav, .menu, .menu__liste a { transition-duration: 120ms; transform: none; }
  }
</style>

<script>
  const nav = document.getElementById('nav')!;
  const menu = document.getElementById('menu')!;
  const burger = document.querySelector<HTMLButtonElement>('.burger')!;

  // 1. La barre ne se dessine qu'une fois le haut de page dépassé.
  const temoin = document.createElement('div');
  temoin.setAttribute('aria-hidden', 'true');
  temoin.style.cssText = 'position:absolute;top:0;height:1px;width:1px;';
  document.body.prepend(temoin);
  new IntersectionObserver(([e]) => nav.toggleAttribute('data-pose', !e.isIntersecting))
    .observe(temoin);

  // 2. La barre s'inverse quand la lanterne passe dessous.
  const ascension = document.getElementById('ascension');
  if (ascension) {
    let derriere = false;
    const relire = () => {
      nav.toggleAttribute('data-nuit', derriere && ascension.dataset.salle === 'lanterne');
    };
    new IntersectionObserver(
      ([e]) => { derriere = e.isIntersecting; relire(); },
      { rootMargin: '-68px 0px -99% 0px' },
    ).observe(ascension);
    new MutationObserver(relire).observe(ascension, {
      attributes: true, attributeFilter: ['data-salle'],
    });
  }

  // 3. Section courante.
  const liens = [...document.querySelectorAll<HTMLAnchorElement>('.nav__liens a')];
  const cibles = liens
    .map((a) => document.querySelector(a.getAttribute('href')!))
    .filter(Boolean) as Element[];
  const obsCourant = new IntersectionObserver(
    (entrees) => {
      for (const e of entrees) {
        if (!e.isIntersecting) continue;
        const id = `#${e.target.id}`;
        liens.forEach((a) => a.setAttribute('aria-current', String(a.getAttribute('href') === id)));
      }
    },
    { rootMargin: '-30% 0px -60% 0px' },
  );
  cibles.forEach((c) => obsCourant.observe(c));

  // 4. Panneau mobile. Il sort par où il est entré.
  let dernierFocus: HTMLElement | null = null;
  const ouvrir = () => {
    dernierFocus = document.activeElement as HTMLElement;
    menu.hidden = false;
    requestAnimationFrame(() => menu.setAttribute('data-ouvert', ''));
    burger.setAttribute('aria-expanded', 'true');
    burger.setAttribute('aria-label', 'Fermer le menu');
    document.body.style.overflow = 'hidden';
    menu.querySelector('a')?.focus();
  };
  const fermer = () => {
    menu.removeAttribute('data-ouvert');
    burger.setAttribute('aria-expanded', 'false');
    burger.setAttribute('aria-label', 'Ouvrir le menu');
    document.body.style.overflow = '';
    const fini = () => { menu.hidden = true; };
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) fini();
    else menu.addEventListener('transitionend', fini, { once: true });
    dernierFocus?.focus();
  };
  burger.addEventListener('click', () =>
    burger.getAttribute('aria-expanded') === 'true' ? fermer() : ouvrir());
  menu.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) fermer();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && burger.getAttribute('aria-expanded') === 'true') fermer();
  });
  matchMedia('(min-width: 62rem)').addEventListener('change', (e) => {
    if (e.matches && burger.getAttribute('aria-expanded') === 'true') fermer();
  });
</script>
