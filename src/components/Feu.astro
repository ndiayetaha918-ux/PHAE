---
import Plate from './Plate.astro';
import { facts } from '../data/site';

const measures = [
  { value: facts.rotationSeconds, unit: 'secondes', note: 'par tour complet' },
  { value: facts.rangeKm, unit: 'kilomètres', note: 'de portée en mer' },
  { value: facts.altitudeM, unit: 'mètres', note: 'au dessus de l’Atlantique' },
  { value: facts.towerM, unit: 'mètres', note: 'de tour seulement' },
];
---

<section class="band section feu" id="le-feu" data-ground="night">
  <div class="wrap">
    <div class="feu__top">
      <div class="feu__say">
        <h2 class="title reveal">
          Elle ne produit pas la lumière.<br />Elle la rassemble.
        </h2>
        <div class="prose feu__prose reveal" style="--reveal-delay:80ms">
          <p>
            Au sommet de la tour, la lentille de Fresnel flotte sur une cuve de
            mercure. Le frottement devient négligeable et l’optique achève un
            tour complet toutes les cinq secondes, sans effort.
          </p>
          <p>
            Chaque anneau à échelons redresse une part du faisceau et la renvoie
            à l’horizontale. C’est ce qui donne au feu blanc sa portée de
            cinquante-trois kilomètres, et au phare son rang: le premier feu
            d’atterrissage de cette partie du continent.
          </p>
        </div>
      </div>

      <Plate
        name="lentille"
        class="feu__plate reveal"
        sizes="(min-width: 60rem) 42vw, 100vw"
      />
    </div>

    <dl class="measures reveal" style="--reveal-delay:140ms">
      {measures.map((m) => (
        <div class="measures__item">
          <dt class="sr-only">{m.note}</dt>
          <dd class="measures__dd">
            <span class="figure-value">{m.value}</span>
            <span class="figure-unit">{m.unit}</span>
            <span class="measures__note">{m.note}</span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .feu { background: linear-gradient(180deg, var(--basalt-800) 0%, var(--basalt-850) 100%); }

  .feu__top {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4.5rem);
    align-items: center;
  }
  @media (min-width: 60rem) {
    .feu__top { grid-template-columns: 1fr 0.82fr; }
  }

  .feu__prose { margin-top: clamp(1.5rem, 3vw, 2.25rem); max-width: 46ch; }
  .feu__plate { max-width: 34rem; width: 100%; justify-self: end; }

  .measures {
    margin: clamp(3.5rem, 9vw, 6rem) 0 0;
    padding-top: 1.75rem;
    border-top: 1px solid var(--rule);
    display: grid;
    gap: 2rem 1.5rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 48rem) {
    .measures { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  .measures__item { min-width: 0; }
  .measures__dd { margin: 0; display: grid; gap: 0.35rem; }
  .measures__note {
    font-variation-settings: 'wdth' 110;
    font-size: 0.75rem;
    line-height: 1.3;
    letter-spacing: 0.02em;
    color: var(--fg-faint);
  }
</style>
