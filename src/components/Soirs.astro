---
import Plate from './Plate.astro';
import { programme, privateEvents } from '../data/site';
---

<section class="band section soirs" id="rendez-vous" data-ground="day">
  <div class="wrap">
    <div class="soirs__head">
      <h2 class="title reveal">Musique live,<br />du mardi au dimanche.</h2>
      <p class="prose soirs__lede reveal" style="--reveal-delay:80ms">
        Le phare reçoit une programmation chaque soir d’ouverture, sur la
        terrasse qui domine la presqu’île. Scène en semaine, formations live
        le week-end, brunch le dimanche.
      </p>
    </div>

    <dl class="schedule">
      {programme.map((slot, i) => (
        <div class="schedule__row reveal" style={`--reveal-delay:${i * 70}ms`}>
          <dt class="schedule__when">{slot.when}</dt>
          <dd class="schedule__what">{slot.what}</dd>
        </div>
      ))}
    </dl>
  </div>

  <Plate name="soir" class="soirs__plate reveal" sizes="100vw" />

  <div class="wrap">
    <div class="soirs__private">
      <h3 class="subtitle reveal">Le site se privatise.</h3>
      <ul class="tags reveal" style="--reveal-delay:70ms">
        {privateEvents.map((e) => <li>{e}</li>)}
      </ul>
      <p class="prose soirs__note reveal" style="--reveal-delay:120ms">
        Les demandes de privatisation se font par téléphone ou par courriel,
        coordonnées plus bas.
      </p>
    </div>
  </div>
</section>

<style>
  .soirs__head { max-width: 52rem; }
  .soirs__lede { margin-top: 1.5rem; }

  .schedule {
    margin: clamp(2.75rem, 7vw, 4.5rem) 0 0;
    border-top: 1px solid var(--rule);
  }
  .schedule__row {
    display: grid;
    gap: 0.35rem 2.5rem;
    padding-block: clamp(1.25rem, 3vw, 1.75rem);
    border-bottom: 1px solid var(--rule);
    align-items: baseline;
  }
  @media (min-width: 48rem) {
    .schedule__row { grid-template-columns: minmax(12rem, 0.4fr) 1fr; }
  }
  .schedule__when {
    font-variation-settings: 'wdth' 113;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.75rem;
    color: var(--fg-muted);
  }
  .schedule__what {
    margin: 0;
    font-variation-settings: 'wdth' 98;
    font-size: clamp(1.0625rem, 1rem + 0.5vw, 1.3rem);
    line-height: 1.3;
    text-wrap: pretty;
  }

  .soirs__plate { margin-top: clamp(3rem, 8vw, 5rem); width: 100%; }

  .soirs__private { margin-top: clamp(3rem, 8vw, 5rem); max-width: 46rem; }

  .tags {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tags li {
    border: 1px solid var(--rule-strong);
    padding: 0.55em 0.9em;
    font-size: 0.8125rem;
    font-variation-settings: 'wdth' 104;
    line-height: 1;
  }

  .soirs__note { margin-top: 1.75rem; }
</style>
