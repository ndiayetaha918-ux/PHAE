---
import { contact, museum, openingHours } from '../data/site';

const mapHref =
  'https://www.google.com/maps/search/?api=1&query=Phare+des+Mamelles+Dakar';
---

<section class="band section venir" id="venir" data-ground="day">
  <div class="wrap">
    <h2 class="title venir__title reveal">Venir au phare.</h2>

    <div class="venir__grid">
      <div class="col reveal">
        <h3 class="label">Le musée</h3>
        <dl class="facts">
          <dt>Ouverture</dt>
          <dd>{museum.hours}</dd>
          <dt>Tarif</dt>
          <dd>{museum.price}</dd>
          <dt>Gratuité</dt>
          <dd>{museum.free}</dd>
          <dt>Billetterie</dt>
          <dd>{museum.ticketing}</dd>
        </dl>
      </div>

      <div class="col reveal" style="--reveal-delay:70ms">
        <h3 class="label">Le lieu</h3>
        <dl class="hours">
          {openingHours.map((row) => (
            <div class="hours__row" data-closed={row.closed ? '' : undefined}>
              <dt>{row.day}</dt>
              <dd>{row.hours}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="col reveal" style="--reveal-delay:140ms">
        <h3 class="label">Adresse</h3>
        <address class="address">
          {contact.address.map((line) => <span>{line}</span>)}
        </address>
        <ul class="reach">
          <li><a class="hit" href={`tel:${contact.phoneHref}`}>{contact.phone}</a></li>
          <li><a class="hit" href={`mailto:${contact.email}`}>{contact.email}</a></li>
        </ul>
        <a class="btn venir__cta" href={mapHref} target="_blank" rel="noopener">
          Ouvrir le plan
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .venir { background: var(--chalk-100); }
  .venir__title { max-width: 20ch; }

  .venir__grid {
    margin-top: clamp(2.5rem, 7vw, 4rem);
    display: grid;
    gap: clamp(2.5rem, 5vw, 3.5rem);
    border-top: 1px solid var(--rule-strong);
    padding-top: clamp(2rem, 4vw, 2.75rem);
  }
  @media (min-width: 54rem) {
    .venir__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  .col { min-width: 0; }
  .col .label { margin-bottom: 1.5rem; color: var(--fg-faint); }

  .facts, .hours { margin: 0; }

  .facts dt {
    font-variation-settings: 'wdth' 110;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.11em;
    color: var(--fg-faint);
    margin-top: 1.25rem;
  }
  .facts dt:first-child { margin-top: 0; }
  .facts dd {
    margin: 0.35rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.4;
    text-wrap: pretty;
  }

  .hours__row {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--rule);
    font-size: 0.9375rem;
  }
  .hours__row:first-child { border-top: 1px solid var(--rule); }
  .hours__row dt { color: var(--fg-muted); }
  .hours__row dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
    font-variation-settings: 'wdth' 98;
  }
  .hours__row[data-closed] dt,
  .hours__row[data-closed] dd { color: var(--fg-faint); }

  .address {
    font-style: normal;
    display: grid;
    gap: 0.15rem;
    font-size: 1.0625rem;
    line-height: 1.4;
  }

  .reach {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
    font-size: 1.0625rem;
  }
  .reach a {
    text-decoration-color: var(--rule-strong);
    transition: text-decoration-color var(--t-ui) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .reach a:hover { text-decoration-color: currentColor; }
  }

  .venir__cta { margin-top: 1.75rem; }
</style>
