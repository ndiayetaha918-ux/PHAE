---
import { plates } from '../data/media';

interface Props {
  /** Clé déclarée dans src/data/media.ts */
  name: keyof typeof plates;
  /** Attribut sizes, pour le choix de résolution. */
  sizes?: string;
  /** Charger sans attendre le défilement (uniquement au dessus de la ligne de flottaison). */
  eager?: boolean;
  class?: string;
}
const { name, sizes = '100vw', eager = false, class: className = '' } = Astro.props;
const plate = plates[name];
const height = Math.round(plate.width / plate.ratio);
---

<figure class={`plate ${className}`} style={`--ratio:${plate.ratio}`}>
  {plate.ready ? (
    <img
      src={plate.src}
      alt={plate.alt}
      width={plate.width}
      height={height}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      decoding={eager ? 'sync' : 'async'}
      fetchpriority={eager ? 'high' : 'auto'}
    />
  ) : (
    <div class="plate__pending" role="img" aria-label={plate.alt}>
      <span class="label">Visuel à fournir</span>
      <span class="archive plate__note">{plate.alt}</span>
      <span class="plate__spec">{plate.width} px de large</span>
    </div>
  )}
</figure>

<style>
  .plate {
    margin: 0;
    aspect-ratio: var(--ratio);
    background: var(--bg-raised);
    overflow: hidden;
    position: relative;
  }
  .plate img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .plate__pending {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 0.9rem;
    padding: clamp(1.25rem, 4vw, 2.5rem);
    text-align: center;
    border: 1px solid var(--rule);
    background:
      radial-gradient(90% 70% at 50% 40%, color-mix(in oklab, var(--fg) 5%, transparent), transparent 70%);
  }
  .plate__note {
    font-size: clamp(0.95rem, 0.85rem + 0.5vw, 1.2rem);
    color: var(--fg-muted);
    max-width: 34ch;
  }
  .plate__spec {
    font-variant-numeric: tabular-nums;
    font-variation-settings: 'wdth' 112;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--fg-faint);
  }
</style>
