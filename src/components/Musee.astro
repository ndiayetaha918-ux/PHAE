---
import Plate from './Plate.astro';
import { collection } from '../data/site';
---

<section class="band section musee" id="le-musee" data-ground="day">
  <div class="wrap musee__grid">
    <div class="musee__aside">
      <div class="musee__sticky">
        <h2 class="title reveal">Le premier musée national<br />des Phares et Balises.</h2>
        <p class="prose musee__lede reveal" style="--reveal-delay:80ms">
          L’exposition occupe le rez-de-chaussée de la tour. Elle part des
          pièces d’archives du projet et remonte jusqu’aux récits attachés à
          la presqu’île.
        </p>
        <Plate
          name="archive"
          class="musee__archive reveal"
          sizes="(min-width: 60rem) 34vw, 100vw"
        />
      </div>
    </div>

    <ol class="entries">
      {collection.map((item, i) => (
        <li class="entry reveal" style={`--reveal-delay:${i * 60}ms`}>
          <h3 class="entry__title">{item.title}</h3>
          {item.year && (
            <p class="archive entry__year">
              pièce la plus ancienne, {item.year}
            </p>
          )}
          <p class="entry__body">{item.body}</p>
        </li>
      ))}
    </ol>
  </div>

  <Plate name="expo" class="musee__expo reveal" sizes="100vw" />
</section>

<style>
  .musee__grid {
    display: grid;
    gap: clamp(2.5rem, 7vw, 5rem);
    align-items: start;
  }
  @media (min-width: 60rem) {
    .musee__grid { grid-template-columns: 0.92fr 1fr; }
    .musee__sticky { position: sticky; top: calc(68px + 3rem); }
  }

  .musee__lede { margin-top: 1.5rem; max-width: 40ch; }
  .musee__archive { margin-top: clamp(2rem, 4vw, 3rem); max-width: 24rem; }

  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: entry;
  }

  .entry {
    padding-block: clamp(1.75rem, 4vw, 2.5rem);
    border-top: 1px solid var(--rule);
    counter-increment: entry;
  }
  .entry:last-child { border-bottom: 1px solid var(--rule); }

  .entry__title {
    font-variation-settings: 'wdth' 97;
    font-weight: 540;
    letter-spacing: -0.015em;
    font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.6rem);
    line-height: 1.14;
    margin: 0;
  }
  /* Le numéro est une aide de lecture, pas une étiquette décorative:
     il n'apparaît qu'à partir de la largeur où il y a de la place. */
  @media (min-width: 48rem) {
    .entry { display: grid; grid-template-columns: 3rem 1fr; column-gap: 1.5rem; }
    .entry::before {
      content: counter(entry, decimal-leading-zero);
      font-variant-numeric: tabular-nums;
      font-variation-settings: 'wdth' 112;
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      color: var(--fg-faint);
      line-height: 1.9;
      grid-row: 1 / span 3;
    }
  }

  .entry__year {
    margin: 0.5rem 0 0;
    font-size: 1.0625rem;
    color: var(--fg-muted);
  }

  .entry__body {
    margin: 0.75rem 0 0;
    color: var(--fg-muted);
    max-width: 56ch;
    text-wrap: pretty;
  }

  .musee__expo { margin-top: clamp(3.5rem, 9vw, 6rem); width: 100%; }
</style>
